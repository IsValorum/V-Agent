{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V-Agent",
  "version": "1.0.1",
  "identifier": "app.v-agent.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "V-Agent",
    "copyright": "Copyright 2026 The V-Agent Authors. Licensed under the Apache License 2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI agent desktop client for llama.cpp, Strata and API models",
    "longDescription": "V-Agent runs local models through official llama.cpp, Strata and Strata Rust builds (or any OpenAI / Claude compatible API) with tools, permissions and isolation.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../dist-release/core/": "core/",
      "../../LICENSE": "LICENSE.txt",
      "../../NOTICE": "NOTICE.txt",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SpanishInternational",
          "English",
          "PortugueseBR",
          "French",
          "German"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "mainBinaryName": "V-Agent"
}
