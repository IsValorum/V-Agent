LangString addOrReinstall ${LANG_VIETNAMESE} "Thêm/Cài lại thành phần"
LangString alreadyInstalled ${LANG_VIETNAMESE} "Đã được cài đặt"
LangString alreadyInstalledLong ${LANG_VIETNAMESE} "${PRODUCTNAME} ${VERSION} đã được cài đặt. Hãy chọn thao tác muốn thực hiện rồi nhấn Tiếp để tiếp tục."
LangString appRunning ${LANG_VIETNAMESE} "{{product_name}} đang chạy! Hãy đóng nó trước rồi thử lại."
LangString noPermissionToCloseApp ${LANG_VIETNAMESE} "Không đủ quyền để đóng {{product_name}}, hãy đóng nó rồi thử lại"
LangString appRunningOkKill ${LANG_VIETNAMESE} "{{product_name}} đang chạy!$\nNhấn OK để buộc đóng"
LangString chooseMaintenanceOption ${LANG_VIETNAMESE} "Chọn tùy chọn bảo trì cần thực hiện."
LangString chooseHowToInstall ${LANG_VIETNAMESE} "Chọn cách cài đặt ${PRODUCTNAME}."
LangString createDesktop ${LANG_VIETNAMESE} "Tạo lối tắt trên màn hình"
LangString dontUninstall ${LANG_VIETNAMESE} "Không gỡ cài đặt"
LangString dontUninstallDowngrade ${LANG_VIETNAMESE} "Không gỡ cài đặt (trình cài đặt này không cho hạ cấp mà không gỡ cài đặt)"
LangString failedToKillApp ${LANG_VIETNAMESE} "Không thể đóng {{product_name}}. Hãy đóng nó trước rồi thử lại"
LangString installingWebview2 ${LANG_VIETNAMESE} "Đang cài WebView2..."
LangString newerVersionInstalled ${LANG_VIETNAMESE} "Đã có phiên bản ${PRODUCTNAME} mới hơn được cài đặt! Không nên cài phiên bản cũ hơn. Nếu bạn thật sự muốn cài phiên bản cũ này, tốt hơn hãy gỡ phiên bản hiện tại trước. Hãy chọn thao tác muốn thực hiện rồi nhấn Tiếp để tiếp tục."
LangString older ${LANG_VIETNAMESE} "cũ hơn"
LangString olderOrUnknownVersionInstalled ${LANG_VIETNAMESE} "Một phiên bản $ExistingVersionKind của ${PRODUCTNAME} đang được cài trên máy. Nên gỡ phiên bản hiện tại trước khi cài. Hãy chọn thao tác muốn thực hiện rồi nhấn Tiếp để tiếp tục."
LangString silentDowngrades ${LANG_VIETNAMESE} "Trình cài đặt này không cho hạ cấp, trình cài đặt im lặng không thể tiếp tục, hãy dùng trình cài đặt có giao diện.$\n"
LangString unableToUninstall ${LANG_VIETNAMESE} "Không thể gỡ cài đặt!"
LangString uninstallApp ${LANG_VIETNAMESE} "Gỡ cài đặt ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_VIETNAMESE} "Gỡ cài đặt trước khi cài"
LangString unknown ${LANG_VIETNAMESE} "không xác định"
LangString webview2AbortError ${LANG_VIETNAMESE} "Cài WebView2 thất bại! Ứng dụng không thể chạy nếu thiếu nó. Hãy thử chạy lại trình cài đặt."
LangString webview2DownloadError ${LANG_VIETNAMESE} "Lỗi: Tải WebView2 thất bại - $Webview2DownloadResult"
LangString webview2DownloadSuccess ${LANG_VIETNAMESE} "Đã tải trình khởi động WebView2 thành công"
LangString webview2Downloading ${LANG_VIETNAMESE} "Đang tải trình khởi động WebView2..."
LangString webview2InstallError ${LANG_VIETNAMESE} "Lỗi: Cài WebView2 thất bại với mã thoát $Webview2InstallExitCode"
LangString webview2InstallSuccess ${LANG_VIETNAMESE} "Đã cài WebView2 thành công"
LangString deleteAppData ${LANG_VIETNAMESE} "Xóa dữ liệu ứng dụng"
